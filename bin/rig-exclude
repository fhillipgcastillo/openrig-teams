#!/usr/bin/env bash
# usage: rig-exclude <path-inside-project> [--runtime codex|claude-code|both]
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

die() { echo "rig-exclude: $*" >&2; exit 1; }

[ $# -eq 1 ] || [ $# -eq 3 ] || die "usage: rig-exclude <path-inside-project> [--runtime codex|claude-code|both]"
runtime=both
if [ $# -eq 3 ]; then
  [ "$2" = --runtime ] || die "expected --runtime"
  runtime=$3
fi
case "$runtime" in codex|claude-code|both) ;; *) die "unknown runtime '$runtime'" ;; esac
git -C "$1" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "$1 is not inside a git repository"
project_root=$(git -C "$1" rev-parse --show-toplevel)

common_dir=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir)
exclude="$common_dir/info/exclude"
begin="# >>> openrig-teams"
end="# <<< openrig-teams"

skills=$(grep -ho 'skills: \[[^]]*\]' "$root"/agents/*/*/agent.yaml \
  | sed 's/skills: \[//; s/\]//' | tr ',' '\n' | tr -d ' ' | sort -u)

block() {
  echo "$begin"
  printf '%s\n' .openrig/
  if [ "$runtime" != codex ]; then
    printf '%s\n' CLAUDE.local.md .mcp.json .claude/settings.local.json ".claude/plugins/shared:openrig-core/"
    for skill in $skills; do echo ".claude/skills/$skill/"; done
  fi
  if [ "$runtime" != claude-code ]; then
    printf '%s\n' AGENTS.md ".codex/plugins/shared:openrig-core/"
    for skill in $skills; do echo ".agents/skills/$skill/"; done
  fi
  echo "$end"
}

paths=$(block | grep -v '^#')
collisions=$(git -C "$project_root" ls-files -- $paths)
if [ -n "$collisions" ]; then
  echo "rig-exclude: the project tracks paths OpenRig overwrites; ask the human before starting teams:" >&2
  printf '  %s\n' $collisions >&2
  exit 2
fi

mkdir -p "$(dirname "$exclude")"
touch "$exclude"
kept=$(sed "/^$begin\$/,/^$end\$/d" "$exclude")
previous=$(sed -n "/^$begin\$/,/^$end\$/p" "$exclude" | sed '/^#/d')
merged=$(printf '%s\n' "$previous" "$paths" | sed '/^$/d' | sort -u)
{ [ -n "$kept" ] && printf '%s\n' "$kept"; printf '%s\n' "$begin" "$merged" "$end"; } > "$exclude.tmp"
mv "$exclude.tmp" "$exclude"

echo "updated $exclude (applies to every worktree of $(basename "$(dirname "$common_dir")"))"
