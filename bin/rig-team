#!/usr/bin/env bash
# usage: rig-team <fe|be|devops> <worktree-path> [plan|up|down|resume|remove|permissions|name]
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

die() { echo "rig-team: $*" >&2; exit 1; }
slug() { tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g'; }

[ $# -ge 2 ] && [ $# -le 3 ] || die "usage: rig-team <fe|be|devops> <worktree-path> [plan|up|down|resume|remove|permissions|name]"
team=$1
action=${3:-up}
template_dir="$root/rigs/$team"
[ -f "$template_dir/rig.yaml" ] || die "no team template at rigs/$team (have: $(ls "$root/rigs" | tr '\n' ' '))"
case "$team" in lead|pm) die "'$team' is not per-worktree; use bin/rig-home $team" ;; esac

worktree=$(realpath "$2")
git -C "$worktree" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "$worktree is not a git worktree"
git_dir=$(git -C "$worktree" rev-parse --path-format=absolute --git-dir)
common_dir=$(git -C "$worktree" rev-parse --path-format=absolute --git-common-dir)
[ "$git_dir" != "$common_dir" ] || die "$worktree is the main checkout; teams only run in linked worktrees"

project=$(basename "$(dirname "$common_dir")" | slug)
job=$(basename "$worktree" | slug)
name="$team-$project-$job"
spec="$template_dir/rig.$project-$job.yaml"

case "$action" in
  name)   echo "$name" ;;
  plan)
    "$root/bin/rig-runtime" check "$team" >/dev/null
    spec="$template_dir/rig.$project-$job.plan.yaml"
    "$root/bin/rig-runtime" render "$team" "$name" "$spec"
    rig up "$spec" --cwd "$worktree" --plan
    "$root/bin/rig-runtime" permissions "$team" "$name" --plan
    ;;
  up)
    "$root/bin/rig-runtime" check "$team" >/dev/null
    "$root/bin/rig-runtime" render "$team" "$name" "$spec"
    rig up "$spec" --cwd "$worktree" --yes
    "$root/bin/rig-runtime" permissions "$team" "$name"
    ;;
  down)   rig down "$name" --snapshot ;;
  resume)
    "$root/bin/rig-runtime" check "$team" >/dev/null
    "$root/bin/rig-runtime" permissions "$team" "$name"
    rig up "$name" --existing
    ;;
  permissions) "$root/bin/rig-runtime" permissions "$team" "$name" ;;
  remove) rig down "$name" --delete --force; rm -f "$spec" "$template_dir/rig.$project-$job.plan.yaml" ;;
  *)      die "unknown action '$action'" ;;
esac

[ "$action" = name ] || echo "team: $name  worktree: $worktree"
