#!/usr/bin/env node
import { jobCommand, legacyCommand, printError } from '../lib/job-cli.mjs';

const args = process.argv.slice(2);
const oldAction = ['can-spawn', 'profile-init', 'doctor'].includes(args[0]);
const oldStart = args[0] === 'start' && !args.includes('--workspace') && !args.includes('--worktree');
const oldFinish = args[0] === 'finish' && args[1] && !/^[a-f0-9]{8}-/.test(args[1]);
try {
  if (oldAction || oldStart || oldFinish || args.includes('--teams')) legacyCommand(args);
  else await jobCommand(args);
} catch (error) { printError(error, args.includes('--json')); }
